# Copy to .env (never commit .env). Real environment variables win over this file.
# The login KAMAR must send to POST /api/kamar. Pick a long random password.
KAMAR_USERNAME=athletics
KAMAR_PASSWORD=change-me-to-a-long-random-password
# Optional
# KAMAR_INFO_URL=https://www.kingshigh.school.nz/
# KAMAR_COUNTRY=New Zealand
# KAMAR_MIN_LEVEL=9
# KAMAR_MAX_LEVEL=13
# ADMIN_EMAIL=organiser@school.test
# ADMIN_PASSWORD=changeme123
